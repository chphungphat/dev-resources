# PostgreSQL Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=mydb
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator123

# Redis Configuration
REDIS_PASSWORD=redis123

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# VerneMQ Configuration
DOCKER_VERNEMQ_ACCEPT_EULA=yes
DOCKER_VERNEMQ_ALLOW_ANONYMOUS=on
DOCKER_VERNEMQ_USER_admin=admin123

# Typesense Configuration
TYPESENSE_DATA_DIR=/data
TYPESENSE_API_KEY=admin123
TYPESENSE_ENABLE_CORS=true

# Meilisearch Configuration
MEILI_MASTER_KEY=admin123
MEILI_ENV=development
MEILI_HTTP_ADDR=0.0.0.0:7700
MEILI_DB_PATH=/meili_data

# MSSQL Configuration
MSSQL_ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Admin123!
MSSQL_PID=Developer
MSSQL_REPLICATION_USER=replicator
MSSQL_REPLICATION_PASSWORD=Replicator123!
